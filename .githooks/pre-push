#!/bin/sh
set -e

echo "pre-push: building project and running tests..."

if ! output="$(npm run --silent build 2>&1)"; then
    echo "pre-push failed: npm run build found issues." >&2
    echo "$output" >&2
    exit 1
fi

if ! output="$(npm test -- --silent 2>&1)"; then
    echo "pre-push failed: npm test found issues." >&2
    echo "$output" >&2
    exit 1
fi

echo "pre-push passed: build and tests clean."
